# I copy this file to .env and I replace every placeholder.
# I never commit .env. I use the same SECRET_KEY and DATABASE_URL on Web01 and Web02.

APP_ENV=local
FLASK_DEBUG=0
SECRET_KEY=replace-with-a-random-64-character-hex-string
DATABASE_URL=postgresql:///courseshelf
BACKEND_NAME=local
BIND_HOST=127.0.0.1
PORT=5050
SESSION_COOKIE_SECURE=0
OPENLIBRARY_TIMEOUT_SECONDS=6
OPENLIBRARY_USER_AGENT=CourseShelf/1.0 (Herve Friend KUBANA; +https://openlibrary.org/dev/docs/api/books)
DEMO_STUDENT_PASSWORD=replace-with-a-long-demo-password
